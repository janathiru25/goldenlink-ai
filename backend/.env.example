# GoldenLink AI - FastAPI Backend Configuration
APP_NAME=GoldenLink AI Backend
PORT=8000
HOST=0.0.0.0
DEBUG=true

# Database Configuration
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=goldenlink

# Demo Mode & Simulation
DEMO_MODE=true

# CORS Configuration
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:3000

# Microservice Integrations
NOTIFICATION_SERVICE_URL=http://localhost:5001

# AI Provider Configuration
# Options: "rule_based", "model", "external_api"
AI_PROVIDER_TYPE=rule_based
AI_MODEL_PATH=
EXTERNAL_AI_API_KEY=
EXTERNAL_AI_ENDPOINT=
